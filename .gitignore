# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# WoW client artifacts - never commit a real WTF directory or account data
WTF/
Cache/
Logs/
Screenshots/

# Real SavedVariables captured from an actual play session (personal history).
# Sanitized fixtures belong explicitly under samples/savedvariables/.
*.lua.bak
AzerothChronicleDB.lua

# Companion (Python)
companion/.venv/
companion/venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Companion local data - never commit a real personal database
companion/*.sqlite3
companion/*.db
*.sqlite3
*.db

# Companion watcher log - can contain event ids and character info
watcher.log
watcher.log.*

# PyInstaller build output - large, reproducible via companion/build_exe.py
companion/build/
companion/dist/
companion/*.spec

# Secrets
.env
*.env
credentials.json
**/api_key*
